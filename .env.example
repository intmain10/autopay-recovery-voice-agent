# --- Vapi (https://dashboard.vapi.ai) ---
VAPI_API_KEY=
# Vapi dashboard -> API Keys -> Public key (for browser calls, no phone number needed)
VAPI_PUBLIC_KEY=
# Vapi dashboard -> Phone Numbers -> your number -> ID (not the number itself)
VAPI_PHONE_NUMBER_ID=
# Filled after: python -m scripts.setup_assistant
VAPI_ASSISTANT_ID=
# Any random string; Vapi sends it as the x-vapi-secret header
VAPI_WEBHOOK_SECRET=change-me
# Your ngrok https URL, e.g. https://abcd.ngrok-free.app
PUBLIC_SERVER_URL=

# The ONLY number that will ever be dialled. Use your own phone, E.164 format.
TEST_PHONE_NUMBER=+91XXXXXXXXXX

# --- Razorpay test mode (optional; blank = mock links) ---
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# --- Optional ---
# Optional: enables live transfer to a human
HUMAN_TRANSFER_NUMBER=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
MERCHANT_NAME=BrightNet Fiber
SUPPORT_NUMBER=1800 000 0000
# DEMO_TODAY=2026-10-04

# Hindi speech-to-text: deepgram (default, Azure fallback) | azure | 11labs | google
HINDI_STT=deepgram
